{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalEnv": [
		"NEXT_PUBLIC_CLOUDINARY_CLOUDNAME",
		"DATABASE_URL",
		"GITHUB_ID",
		"GITHUB_SECRET",
		"NEXTAUTH_SECRET",
		"NEXTAUTH_URL",
		"VERCEL_URL",
		"GITHUB_TOKEN",
		"GITHUB_CLIENT_ID",
		"GITHUB_CLIENT_SECRET",
		"GITHUB_TOKEN_SECRET",
		"GITHUB_REPO",
		"GITHUB_REPO_ID",
		"GITHUB_CATEGORY",
		"GITHUB_CATEGORY_ID",
		"GITHUB_OWNER",
		"GITHUB_READ_TOKEN",
		"UPLOADTHING_TOKEN",
		"UPLOADTHING_TOKEN"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"check:types": {},
		"lint": {},
		"test": {},
		"test:integrate": {},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
